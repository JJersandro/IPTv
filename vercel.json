{
  "headers": [
    {
      "source": "/catalog/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300, s-maxage=600"
        }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "ignoreCommand": "git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA:-x}^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)catalog'"
}